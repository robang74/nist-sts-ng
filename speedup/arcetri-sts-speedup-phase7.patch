From 105bcc33157dc1db5a617eeaf2a38b7909ac7899 Mon Sep 17 00:00:00 2001
From: "Roberto A. Foglietta" <roberto.foglietta@gmail.com>
Date: Fri, 27 Nov 2026 20:29:21 +0100
Subject: [PATCH] speedup/phase7: speeding up, patch p.7

Signed-off-by: Roberto A. Foglietta <roberto.foglietta@gmail.com>
---
 src/Makefile           |  7 ++++++
 src/utils/defs.h       |  1 +
 src/utils/parse_args.c | 49 +++++++++++++++++++++++++++++++-------
 src/utils/utilities.c  | 53 ++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 101 insertions(+), 9 deletions(-)

diff --git a/src/Makefile b/src/Makefile
index 551c1fb..b149df0 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -59,6 +59,13 @@ LOC_INC= -I /usr/include -I /usr/global/include -I /usr/local/include
 #CFLAGS= -std=c99 -D_ISOC99_SOURCE -Wall -Werror -pedantic ${LOC_INC} ${OPT} ${DEBUG}
 CFLAGS= -std=c99 -D_ISOC99_SOURCE -Wall -pedantic ${LOC_INC} ${DEBUG} ${OPT}
 
+# Keep each persistent worker on one allowed logical CPU by default.
+# Use "make PIN_CPUS=0" to disable CPU affinity for comparison.
+PIN_CPUS ?= 1
+ifeq ($(PIN_CPUS),1)
+CFLAGS += -D_USE_PIN_CPUS
+endif
+
 # locations
 #
 ROOTDIR= ..
diff --git a/src/utils/defs.h b/src/utils/defs.h
index 56d2125..2d132bb 100644
--- a/src/utils/defs.h
+++ b/src/utils/defs.h
@@ -514,6 +514,7 @@ struct thread_state {
 	struct state *global_state;
 	long int iteration_being_done;
 	pthread_mutex_t *mutex;
+	int cpu_id;                            // Assigned logical CPU; -1 means unpinned
 };
 
 /* *INDENT-ON* */
diff --git a/src/utils/parse_args.c b/src/utils/parse_args.c
index afd32ed..760430e 100644
--- a/src/utils/parse_args.c
+++ b/src/utils/parse_args.c
@@ -36,6 +36,9 @@
 #include <sys/stat.h>
 #include <errno.h>
 #include <unistd.h>
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+#include <sched.h>
+#endif
 #include <dirent.h>
 #include <math.h>
 #include "../utils/externs.h"
@@ -47,6 +50,33 @@
  */
 static void change_params(struct state *state, long int parameter, long int value, double d_value);
 
+/*
+ * Return the number of logical CPUs available to this process.
+ * On Linux, sched_getaffinity() also observes taskset/cpuset restrictions.
+ */
+static long int
+getAvailableCPUCount(void)
+{
+	long int count;
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+	cpu_set_t allowed_cpus;
+	int cpu;
+
+	count = 0;
+	CPU_ZERO(&allowed_cpus);
+	if (sched_getaffinity(0, sizeof(allowed_cpus), &allowed_cpus) == 0) {
+		for (cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
+			if (CPU_ISSET(cpu, &allowed_cpus))
+				++count;
+		}
+		if (count > 0)
+			return count;
+	}
+#endif
+	count = sysconf(_SC_NPROCESSORS_ONLN);
+	return (count > 0) ? count : 1;
+}
+
 /*
  * Default run state
  *
@@ -398,7 +428,7 @@ parse_args(struct state *state, int argc, char **argv)
 	double d_value;		// Parsed parameter floating point
 	bool success = false;	// true if str2longint was successful
 	int test_cnt = 0;
-	long int i;
+	long int i, available_cpus;
 
 	/*
 	 * Record the program name
@@ -787,6 +817,7 @@ parse_args(struct state *state, int argc, char **argv)
 	if (test_cnt == 0 && state->batchmode == true) {
 		err(1, __func__, "no tests enabled");
 	}
+	available_cpus = getAvailableCPUCount();
 
 	/*
 	 * Set the number of uniformity bins to sqrt(iterations) if running in non-legacy mode and
@@ -808,20 +839,20 @@ parse_args(struct state *state, int argc, char **argv)
 
 	/*
 	 * If no custom number of threads was set, set the number of threads to be equal to the minimum
-	 * between the number of bitstreams and the number of cores of the computer where sts is running.
+	 * between the number of bitstreams and the logical CPUs available to this process.
 	 */
 	else if (state->numberOfThreadsFlag == false) {
-		state->numberOfThreads = MIN(sysconf(_SC_NPROCESSORS_ONLN), state->tp.numOfBitStreams);
+		state->numberOfThreads = MIN(available_cpus, state->tp.numOfBitStreams);
 	}
 
 	/*
-	 * If a custom number of threads was set and this number is greater than the number of processors
-	 * in the computer where sts is running, fire a warning to the user that this will not benefit sts.
+	 * If a custom number of threads was set and this number is greater than the number of logical
+	 * CPUs available to this process, fire a warning that this will usually not benefit sts.
 	 */
-	if (state->numberOfThreadsFlag == true && state->numberOfThreads > sysconf(_SC_NPROCESSORS_ONLN)) {
-		warn(__func__, "You selected a number of threads which is greater than the number of cores in this computer."
-				     " For better performance, you should choose a number of threads < %ld.",
-		     sysconf(_SC_NPROCESSORS_ONLN));
+	if (state->numberOfThreadsFlag == true && state->numberOfThreads > available_cpus) {
+		warn(__func__, "You selected more threads than logical CPUs available to this process."
+				     " For better performance, choose a number of threads <= %ld.",
+		     available_cpus);
 	}
 
 	/*
diff --git a/src/utils/utilities.c b/src/utils/utilities.c
index 9b48120..27228eb 100644
--- a/src/utils/utilities.c
+++ b/src/utils/utilities.c
@@ -40,6 +40,9 @@
 #include <limits.h>
 #include <pthread.h>
 #include <unistd.h>
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+#include <sched.h>
+#endif
 
 // for checking dir
 #include <fcntl.h>
@@ -1487,6 +1490,12 @@ handleFileBasedBitStreams(struct state *state)
 	pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
 	struct thread_state *thread_args = malloc(state->numberOfThreads * sizeof(struct thread_state));
 	void *status;
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+	cpu_set_t allowed_cpus;
+	int cpu_list[CPU_SETSIZE];
+	int cpu_count = 0;
+	int cpu;
+#endif
 
 	/*
 	 * Check preconditions (firewall)
@@ -1527,6 +1536,25 @@ handleFileBasedBitStreams(struct state *state)
 		state->base_seek = ((state->jobnum * state->tp.n * state->tp.numOfBitStreams) + BITS_N_BYTE - 1) / BITS_N_BYTE;
 	}
 
+	/*
+	 * Snapshot the CPUs available to this process. Each persistent worker gets
+	 * one CPU from this list and keeps that affinity for its entire lifetime.
+	 */
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+	CPU_ZERO(&allowed_cpus);
+	if (sched_getaffinity(0, sizeof(allowed_cpus), &allowed_cpus) == 0) {
+		for (cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
+			if (CPU_ISSET(cpu, &allowed_cpus))
+				cpu_list[cpu_count++] = cpu;
+		}
+	}
+	if (cpu_count == 0) {
+		warn(__func__, "cannot obtain the allowed CPU set; workers will run without pinning");
+	} else {
+		dbg(DBG_MED, "CPU pinning enabled for %d allowed logical CPUs", cpu_count);
+	}
+#endif
+
 	/*
 	 * Initialize and set thread detached attribute
 	 */
@@ -1542,6 +1570,14 @@ handleFileBasedBitStreams(struct state *state)
 		thread_args[i].global_state = state;
 		thread_args[i].thread_id = i;
 		thread_args[i].mutex = &mutex;
+		thread_args[i].cpu_id = -1;
+
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+		if (cpu_count > 0)
+			thread_args[i].cpu_id = cpu_list[i % cpu_count];
+		if (thread_args[i].cpu_id >= 0)
+			dbg(DBG_MED, "Assigning worker %ld to logical CPU %d", i, thread_args[i].cpu_id);
+#endif
 
 		io_ret = pthread_create(&thread[i], &attr, testBits, &thread_args[i]);
 		if (io_ret != 0) {
@@ -1595,6 +1631,23 @@ static void
 	if (state == NULL) {
 		err(225, __func__, "state arg is NULL");
 	}
+	/* Pin once: this worker keeps the same logical CPU while it claims and
+	 * processes subsequent iterations from the shared work queue. */
+#if defined(_USE_PIN_CPUS) && defined(__linux__)
+	if (thread_state->cpu_id >= 0) {
+		cpu_set_t worker_cpu;
+		int affinity_error;
+
+		CPU_ZERO(&worker_cpu);
+		CPU_SET(thread_state->cpu_id, &worker_cpu);
+		affinity_error = pthread_setaffinity_np(pthread_self(), sizeof(worker_cpu), &worker_cpu);
+		if (affinity_error != 0)
+			warn(__func__, "thread %ld could not pin to CPU %d: %s; continuing unpinned",
+			     thread_state->thread_id, thread_state->cpu_id, strerror(affinity_error));
+		else
+			dbg(DBG_MED, "Thread %ld pinned to logical CPU %d", thread_state->thread_id, thread_state->cpu_id);
+	}
+#endif
 
 	dbg(DBG_HIGH, "Thread %ld started.", thread_state->thread_id);
 
-- 
