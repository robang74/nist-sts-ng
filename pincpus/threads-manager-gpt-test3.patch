From 17316b00b591d4354097effc4ae9789afb03198f Mon Sep 17 00:00:00 2001
From: "Roberto A. Foglietta" <roberto.foglietta@gmail.com>
Date: Sat, 28 Nov 2026 00:27:42 +0100
Subject: [PATCH] patched in phase 8 (bis), fixing p.8

Signed-off-by: Roberto A. Foglietta <roberto.foglietta@gmail.com>
---
 src/Makefile           | 22 ++++++++++++++++++++++
 src/utils/defs.h       |  4 ++++
 src/utils/parse_args.c | 42 ++----------------------------------------
 src/utils/utilities.c  | 26 +++++++++++++-------------
 4 files changed, 41 insertions(+), 53 deletions(-)

diff --git a/src/Makefile b/src/Makefile
index 48a0674..a0a367b 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -64,6 +64,28 @@ CFLAGS= -std=c99 -D_ISOC99_SOURCE -Wall -pedantic ${LOC_INC} ${DEBUG} ${OPT}
 PIN_CPUS ?= 0
 ifeq ($(PIN_CPUS),1)
 CFLAGS += -D_USE_PIN_CPUS
+
+# Probe the GNU pthread affinity entry points rather than assuming that
+# _GNU_SOURCE implies that every libc implements both interfaces.
+HAVE_PTHREAD_SETAFFINITY_NP := $(shell printf '%s\n' \
+    '#define _GNU_SOURCE' \
+    '#include <pthread.h>' \
+    '#include <sched.h>' \
+    'int main(void) { cpu_set_t s; CPU_ZERO(&s); return pthread_setaffinity_np(pthread_self(), sizeof(s), &s); }' \
+    | $(CC) $(CFLAGS) -pthread -x c -o /dev/null - >/dev/null 2>&1 && echo 1)
+ifeq ($(HAVE_PTHREAD_SETAFFINITY_NP),1)
+CFLAGS += -DHAVE_PTHREAD_SETAFFINITY_NP
+endif
+
+HAVE_PTHREAD_ATTR_SETAFFINITY_NP := $(shell printf '%s\n' \
+    '#define _GNU_SOURCE' \
+    '#include <pthread.h>' \
+    '#include <sched.h>' \
+    'int main(void) { pthread_attr_t a; cpu_set_t s; pthread_attr_init(&a); CPU_ZERO(&s); return pthread_attr_setaffinity_np(&a, sizeof(s), &s); }' \
+    | $(CC) $(CFLAGS) -pthread -x c -o /dev/null - >/dev/null 2>&1 && echo 1)
+ifeq ($(HAVE_PTHREAD_ATTR_SETAFFINITY_NP),1)
+CFLAGS += -DHAVE_PTHREAD_ATTR_SETAFFINITY_NP
+endif
 endif
 
 # locations
diff --git a/src/utils/defs.h b/src/utils/defs.h
index 2d132bb..850f129 100644
--- a/src/utils/defs.h
+++ b/src/utils/defs.h
@@ -515,6 +515,10 @@ struct thread_state {
 	long int iteration_being_done;
 	pthread_mutex_t *mutex;
 	int cpu_id;                            // Assigned logical CPU; -1 means unpinned
+	long int *cpu_owner;                   // CPU id -> owning thread_id; -1 means free
+	int *cpu_list;                         // Allowed logical CPU ids
+	int cpu_count;                         // Number of entries in cpu_list
+	int cpu_attr_set;                      // Affinity was applied before pthread_create()
 };
 
 /* *INDENT-ON* */
diff --git a/src/utils/parse_args.c b/src/utils/parse_args.c
index a0d1bbd..486f434 100644
--- a/src/utils/parse_args.c
+++ b/src/utils/parse_args.c
@@ -36,7 +36,7 @@
 #include <sys/stat.h>
 #include <errno.h>
 #include <unistd.h>
-#if defined(_USE_PIN_CPUS) && defined(__linux__)
+#if defined(__linux__)
 #include <sched.h>
 #endif
 #include <dirent.h>
@@ -50,33 +50,6 @@
  */
 static void change_params(struct state *state, long int parameter, long int value, double d_value);
 
-/*
- * Return the number of logical CPUs available to this process.
- * On Linux, sched_getaffinity() also observes taskset/cpuset restrictions.
- */
-static long int
-getAvailableCPUCount(void)
-{
-	long int count;
-#if defined(_USE_PIN_CPUS) && defined(__linux__)
-	cpu_set_t allowed_cpus;
-	int cpu;
-
-	count = 0;
-	CPU_ZERO(&allowed_cpus);
-	if (sched_getaffinity(0, sizeof(allowed_cpus), &allowed_cpus) == 0) {
-		for (cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
-			if (CPU_ISSET(cpu, &allowed_cpus))
-				++count;
-		}
-		if (count > 0)
-			return count;
-	}
-#endif
-	count = sysconf(_SC_NPROCESSORS_ONLN);
-	return (count > 0) ? count : 1;
-}
-
 /*
  * Default run state
  *
@@ -428,7 +401,7 @@ parse_args(struct state *state, int argc, char **argv)
 	double d_value;		// Parsed parameter floating point
 	bool success = false;	// true if str2longint was successful
 	int test_cnt = 0;
-	long int i, available_cpus;
+	long int i;
 
 	/*
 	 * Record the program name
@@ -817,7 +790,6 @@ parse_args(struct state *state, int argc, char **argv)
 	if (test_cnt == 0 && state->batchmode == true) {
 		err(1, __func__, "no tests enabled");
 	}
-	available_cpus = getAvailableCPUCount();
 
 	/*
 	 * Set the number of uniformity bins to sqrt(iterations) if running in non-legacy mode and
@@ -861,16 +833,6 @@ parse_args(struct state *state, int argc, char **argv)
 		     , sysconf(_SC_NPROCESSORS_ONLN)/2);
 	}
 
-	/*
-	 * If a custom number of threads was set and this number is greater than the number of bitstreams
-	 * (aka iterations) set, fire a warning to the user that only $numOfBitstreams threads will be used.
-	 */
-	if (state->numberOfThreadsFlag == true && state->numberOfThreads > state->tp.numOfBitStreams) {
-		warn(__func__, "You chose to use %ld threads. However this number is greater than the number of bitstreams, which"
-				     " you set to %ld. Therefore only %ld threads will be used.", state->numberOfThreads,
-		     state->tp.numOfBitStreams, state->tp.numOfBitStreams);
-		state->numberOfThreads = state->tp.numOfBitStreams;
-	}
 
 	/*
 	 * Look for the matching .pvalues files in the folder given with -d
diff --git a/src/utils/utilities.c b/src/utils/utilities.c
index 0e1887b..6002ab7 100644
--- a/src/utils/utilities.c
+++ b/src/utils/utilities.c
@@ -42,10 +42,6 @@
 #include <unistd.h>
 #if defined(_USE_PIN_CPUS) && defined(__linux__)
 #include <sched.h>
-/* glibc provides the GNU thread-attribute affinity API; musl does not. */
-#if defined(_GNU_SOURCE) && defined(__GLIBC__)
-#define HAVE_PTHREAD_ATTR_SETAFFINITY_NP 1
-#endif
 #endif
 
 // for checking dir
@@ -1495,9 +1491,7 @@ handleFileBasedBitStreams(struct state *state)
 	void *status;
 #if defined(_USE_PIN_CPUS) && defined(__linux__)
 	cpu_set_t allowed_cpus;
-	int cpu_list[CPU_SETSIZE];
 	int cpu_count = 0;
-	int cpu;
 #endif
 
 	/*
@@ -1545,16 +1539,22 @@ handleFileBasedBitStreams(struct state *state)
 	 */
 #if defined(_USE_PIN_CPUS) && defined(__linux__)
 	CPU_ZERO(&allowed_cpus);
-	if (sched_getaffinity(0, sizeof(allowed_cpus), &allowed_cpus) == 0) {
-		for (cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
-			if (CPU_ISSET(cpu, &allowed_cpus))
-				cpu_list[cpu_count++] = cpu;
-		}
-	}
-	if (cpu_count == 0) {
+ 	if (sched_getaffinity(0, sizeof(allowed_cpus), &allowed_cpus) == 0) {
+ 		for (int cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
+ 			if (CPU_ISSET(cpu, &allowed_cpus))
+ 				cpu_count++;
+ 		}
+ 	}
+ 	if (cpu_count == 0) {
 		warn(__func__, "cannot obtain the allowed CPU set; workers will run without pinning");
 	} else {
 		dbg(DBG_MED, "CPU pinning enabled for %d allowed logical CPUs", cpu_count);
+		/* The affinity mask may have changed since command-line parsing. */
+		if (state->numberOfThreads > cpu_count) {
+			warn(__func__, "worker count exceeds the current allowed CPU set; "
+			     "reducing it from %ld to %d", state->numberOfThreads, cpu_count);
+			state->numberOfThreads = cpu_count;
+		}
 	}
 #endif
 
